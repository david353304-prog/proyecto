# Variables de entorno del chatbot jurídico RAG
# Este archivo contiene ejemplos, no credenciales reales.

# Clave API de Gemini.
# Configurar mediante las variables de entorno del sistema
# o los secretos de GitHub Codespaces.
GEMINI_API_KEY=REEMPLAZAR_CON_CLAVE_PROPIA

# Puerto del servidor Node.js.
PORT=3000

# Opcional. Lista de orígenes exactos separados por comas.
# La interfaz servida por Node funciona en el mismo origen.
CORS_ORIGINS=
